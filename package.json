{
  "name": "attendance-tracker",
  "version": "1.0.0",
  "description": "A Node.js + Express + PostgreSQL attendance tracking web application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup": "node setup-db.js",
    "client": "cd client && npm start",
    "client-install": "cd client && npm install",
    "client-build": "cd client && npm run build",
    "build": "npm run client-install && npm run client-build",
    "dev-full": "concurrently \"npm run dev\" \"npm run client\"",
    "postinstall": "npm run client-install"
  },
  "keywords": ["attendance", "nodejs", "express", "postgresql", "neondb"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.1.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
